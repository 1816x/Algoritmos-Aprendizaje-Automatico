        "# define purchase dates, amounts, and the reference date\n",
        "purchase_dates = pd.to_datetime(['2026-01-03', '2026-01-06', '2026-01-08'])\n",
        "purchase_amounts = [100, 200, 90]\n",
        "reference_date = pd.Timestamp('2026-01-10')\n",
        "\n",
        "# calculate rfm values\n",
        "recency = (reference_date - purchase_dates.max()).days\n",
        "frequency = len(purchase_dates)\n",
        "monetary = sum(purchase_amounts)\n",
        "\n",
