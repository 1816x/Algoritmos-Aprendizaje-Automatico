        "## challenge 4: silhouette score comparison\n",
        "\n",
        "the guide asks for `k = 3, 4, 5`, but the previous example contains only four rows. a silhouette score requires fewer clusters than samples, so this challenge uses a larger simulated rfm dataset only to make all three requested values of `k` valid."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "59b93537",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-09-04T00:03:00.653248Z",
          "iopub.status.busy": "2026-09-04T00:03:00.653062Z",
          "iopub.status.idle": "2026-09-04T00:03:00.793402Z",
          "shell.execute_reply": "2026-09-04T00:03:00.793081Z"
        },
        "id": "59b93537",
        "outputId": "a4a4c936-b6d2-40e6-e23a-a0bdab39fecc"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "k=3 -> silhouette score: 0.6248\n",
            "k=4 -> silhouette score: 0.5234\n",
            "k=5 -> silhouette score: 0.4664\n",
            "\n",
            "best k: 3\n"
          ]
        }
      ],
      "source": [
        "from sklearn.cluster import KMeans as kmeans\n",
        "from sklearn.metrics import silhouette_score\n",
        "\n",
        "# create a larger simulated rfm dataset for the requested k values\n",
        "rfm_model_data = pd.DataFrame({\n",
        "    'recency': [2, 4, 6, 35, 42, 50, 90, 105, 120, 8, 18, 65],\n",
        "    'frequency': [15, 14, 12, 6, 5, 4, 2, 1, 1, 10, 8, 3],\n",
        "    'monetary': [4500, 4200, 3900, 1200, 950, 800, 180, 90, 50, 2800, 2100, 500]\n",
        "})\n",
        "\n",
        "# apply the same transformation and scaling process\n",
        "rfm_model_log = rfm_model_data.copy()\n",
        "rfm_model_log['frequency'] = np.log1p(rfm_model_log['frequency'])\n",
        "rfm_model_log['monetary'] = np.log1p(rfm_model_log['monetary'])\n",
        "x_model_scaled = standard_scaler().fit_transform(rfm_model_log)\n",
        "\n",
        "# compare silhouette scores\n",
        "scores = {}\n",
        "\n",
        "for k in [3, 4, 5]:\n",
        "    labels = kmeans(n_clusters=k, random_state=42, n_init=10).fit_predict(x_model_scaled)\n",
        "    score = silhouette_score(x_model_scaled, labels)\n",
        "    scores[k] = score\n",
        "    print(f'k={k} -> silhouette score: {score:.4f}')\n",
        "\n",
        "best_k = max(scores, key=scores.get)\n",
        "print('\\nbest k:', best_k)"
      ]
    },
