      "source": [
        "import pandas as pd\n",
        "\n",
        "# create simulated transaction data\n",
        "df_raw = pd.DataFrame({\n",
        "    'customer_id': [101, 102, 101, None, 103],\n",
        "    'quantity': [2, -1, 5, 3, 1],\n",
        "    'unit_price': [10, 50, 20, 15, 100]\n",
        "})\n",
        "\n",
        "# remove missing customers and invalid transactions\n",
        "df_clean = df_raw.dropna(subset=['customer_id']).copy()\n",
        "df_clean = df_clean[(df_clean['quantity'] > 0) & (df_clean['unit_price'] > 0)].copy()\n",
        "\n",
        "# calculate the total amount for each transaction line\n",
        "df_clean['total_price'] = df_clean['quantity'] * df_clean['unit_price']\n",
        "\n",
        "print(df_clean)"
      ]
